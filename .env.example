# Copy to .env — docker compose reads it automatically.
# Everything here is optional; an empty file gives you working defaults.

# SIP extension your softphone registers as.
SIP_USER=6001

# Fixed default, same on every machine and every restart. Change it if the
# container is reachable by anyone you would not hand the keypad to.
SIP_PASSWORD=infocom

# Fixes one-way / silent audio. Set to the address the softphone dials —
# i.e. the Docker/Podman host as seen from the phone, not the container.
#   Docker Desktop (Win/macOS): your machine's LAN IP, e.g. 192.168.1.20
#   Podman on WSL:              wsl -d podman-machine-default ip -4 addr show
SIP_EXTERNAL_IP=

# Subnet Asterisk should treat as local (no NAT rewriting), e.g.
# 192.168.0.0/16 or 10.0.0.0/8.
SIP_LOCAL_NET=

# TTS engine: espeak | piper | gtts.
# Empty = piper, which is what amd64 images ship and the voice this is meant
# to be played with. arm64 images have no piper and use espeak.
ZORKPBX_TTS_ENGINE=

# DEBUG | INFO | WARNING | ERROR
ZORKPBX_LOG_LEVEL=INFO
